{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:transflow:worker-control:v1",
  "title": "Transflow T012 wire contract definitions",
  "$comment": "Authored contract baseline. Assert transflow-* formats and x-transflow-invariant rules; see README. Production transport/code generation is T014.",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "transflow-uuid"
    },
    "Sha256": {
      "type": "string",
      "format": "transflow-sha256"
    },
    "Count": {
      "type": "string",
      "format": "transflow-u64"
    },
    "RelativePath": {
      "type": "string",
      "format": "transflow-relative-path"
    },
    "DatasetKey": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/Uuid"
        },
        "dataset_id": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "workspace_id",
        "dataset_id"
      ],
      "additionalProperties": false
    },
    "LogicalType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bool"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i8"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i16"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i32"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i64"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u8"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u16"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u32"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u64"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "f32"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "f64"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "binary"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "date"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "decimal"
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 38
            },
            "scale": {
              "type": "integer",
              "minimum": -38,
              "maximum": 38
            }
          },
          "required": [
            "type",
            "precision",
            "scale"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "timestamp"
            },
            "unit": {
              "enum": [
                "s",
                "ms",
                "us",
                "ns"
              ]
            },
            "timezone": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "transflow-timezone"
                }
              ]
            }
          },
          "required": [
            "type",
            "unit",
            "timezone"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "element": {
              "$ref": "#/$defs/Field"
            }
          },
          "required": [
            "type",
            "element"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "struct"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Field"
              },
              "minItems": 0
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false,
          "x-transflow-invariant": "field-names"
        }
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "format": "transflow-name"
        },
        "logical_type": {
          "$ref": "#/$defs/LogicalType"
        },
        "nullable": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "logical_type",
        "nullable"
      ],
      "additionalProperties": false
    },
    "LogicalSchemaV1": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          },
          "minItems": 0
        }
      },
      "required": [
        "format_version",
        "fields"
      ],
      "additionalProperties": false,
      "x-transflow-invariant": "field-names"
    },
    "ScalarValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "null"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "binary"
            },
            "value": {
              "type": "string",
              "format": "transflow-base64"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "transflow-date"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i8"
            },
            "value": {
              "type": "string",
              "format": "transflow-i8"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i16"
            },
            "value": {
              "type": "string",
              "format": "transflow-i16"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i32"
            },
            "value": {
              "type": "string",
              "format": "transflow-i32"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "i64"
            },
            "value": {
              "type": "string",
              "format": "transflow-i64"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u8"
            },
            "value": {
              "type": "string",
              "format": "transflow-u8"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u16"
            },
            "value": {
              "type": "string",
              "format": "transflow-u16"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u32"
            },
            "value": {
              "type": "string",
              "format": "transflow-u32"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "u64"
            },
            "value": {
              "type": "string",
              "format": "transflow-u64"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "f32"
            },
            "value": {
              "type": "string",
              "format": "transflow-f32"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "f64"
            },
            "value": {
              "type": "string",
              "format": "transflow-f64"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string"
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 38
            },
            "scale": {
              "type": "integer",
              "minimum": -38,
              "maximum": 38
            }
          },
          "required": [
            "type",
            "value",
            "precision",
            "scale"
          ],
          "additionalProperties": false,
          "x-transflow-invariant": "decimal-value"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "timestamp"
            },
            "value": {
              "type": "string"
            },
            "unit": {
              "enum": [
                "s",
                "ms",
                "us",
                "ns"
              ]
            },
            "timezone": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "transflow-timezone"
                }
              ]
            }
          },
          "required": [
            "type",
            "value",
            "unit",
            "timezone"
          ],
          "additionalProperties": false,
          "x-transflow-invariant": "timestamp-value"
        }
      ]
    },
    "WireValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScalarValue"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WireValue"
              },
              "minItems": 0
            }
          },
          "required": [
            "type",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "struct"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "format": "transflow-name"
                  },
                  "value": {
                    "$ref": "#/$defs/WireValue"
                  }
                },
                "required": [
                  "name",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false,
          "x-transflow-invariant": "field-names"
        }
      ]
    },
    "ArtifactFileV1": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/RelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "byte_length": {
          "$ref": "#/$defs/Count"
        },
        "row_count": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "path",
        "sha256",
        "byte_length",
        "row_count"
      ],
      "additionalProperties": false
    },
    "ArtifactManifestV1": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "logical_schema": {
          "$ref": "#/$defs/LogicalSchemaV1"
        },
        "schema_fingerprint": {
          "$ref": "#/$defs/Sha256"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactFileV1"
          },
          "minItems": 1
        },
        "writer": {
          "type": "object",
          "properties": {
            "engine": {
              "enum": [
                "polars",
                "pandas",
                "duckdb",
                "import"
              ]
            },
            "version": {
              "type": "string",
              "format": "transflow-name"
            },
            "compression": {
              "enum": [
                "uncompressed",
                "snappy",
                "zstd"
              ]
            },
            "row_group_size": {
              "$ref": "#/$defs/Count"
            }
          },
          "required": [
            "engine",
            "version",
            "compression",
            "row_group_size"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format_version",
        "logical_schema",
        "schema_fingerprint",
        "files",
        "writer"
      ],
      "additionalProperties": false,
      "x-transflow-invariant": "file-names"
    },
    "CatalogEntryV1": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/DatasetKey"
        },
        "path": {
          "type": "string",
          "format": "transflow-dataset-path"
        },
        "kind": {
          "enum": [
            "source",
            "transform",
            "imported",
            "external"
          ]
        }
      },
      "required": [
        "key",
        "path",
        "kind"
      ],
      "additionalProperties": false
    },
    "CatalogSnapshotV1": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "workspace_id": {
          "$ref": "#/$defs/Uuid"
        },
        "source_snapshot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "catalog_fingerprint": {
          "$ref": "#/$defs/Sha256"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogEntryV1"
          },
          "minItems": 0
        }
      },
      "required": [
        "format_version",
        "workspace_id",
        "source_snapshot_id",
        "catalog_fingerprint",
        "entries"
      ],
      "additionalProperties": false,
      "x-transflow-invariant": "catalog-entries"
    },
    "ProtocolVersion": {
      "type": "object",
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false
    },
    "ControlMessageV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "hello"
            },
            "operation": {
              "enum": [
                "discover",
                "execute",
                "evaluate_checks",
                "query_preview",
                "infer_lineage",
                "inspect_environment"
              ]
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "transflow-name"
              },
              "minItems": 0,
              "maxItems": 64
            }
          },
          "required": [
            "type",
            "operation",
            "capabilities"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "phase"
            },
            "phase": {
              "enum": [
                "setup",
                "discovering",
                "validating_inputs",
                "running",
                "materializing",
                "validating_outputs",
                "querying",
                "inferring_lineage",
                "inspecting_environment"
              ]
            }
          },
          "required": [
            "type",
            "phase"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "heartbeat"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "metric"
            },
            "name": {
              "type": "string",
              "format": "transflow-name"
            },
            "value": {
              "$ref": "#/$defs/ScalarValue"
            }
          },
          "required": [
            "type",
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "artifact_ready"
            },
            "manifest_path": {
              "$ref": "#/$defs/RelativePath"
            },
            "artifact_digest": {
              "$ref": "#/$defs/Sha256"
            }
          },
          "required": [
            "type",
            "manifest_path",
            "artifact_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "check_results"
            },
            "results_path": {
              "$ref": "#/$defs/RelativePath"
            },
            "results_digest": {
              "$ref": "#/$defs/Sha256"
            }
          },
          "required": [
            "type",
            "results_path",
            "results_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "completed"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "error"
            },
            "code": {
              "type": "string",
              "format": "transflow-name"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ControlFrameV1": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "request_id": {
          "$ref": "#/$defs/Uuid"
        },
        "attempt_id": {
          "$ref": "#/$defs/Uuid"
        },
        "sequence": {
          "$ref": "#/$defs/Count"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "transflow-name"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "format": "transflow-name"
              },
              "value": {
                "$ref": "#/$defs/ScalarValue"
              }
            },
            "required": [
              "capability",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        },
        "message": {
          "$ref": "#/$defs/ControlMessageV1"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "attempt_id",
        "sequence",
        "required_capabilities",
        "extensions",
        "message"
      ],
      "additionalProperties": false,
      "x-transflow-invariant": "frame-capabilities"
    }
  },
  "$ref": "#/$defs/ControlFrameV1"
}
