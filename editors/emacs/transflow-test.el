;;; transflow-test.el --- Actual native client contract -*- lexical-binding: t; -*-
(require 'ert)
(require 'transflow)
(defun transflow-test--buffer (root text)
  (let ((buffer (find-file-noselect (expand-file-name "src/editor-test.py" root))))
    (with-current-buffer buffer
      (erase-buffer) (insert text) (python-mode) (goto-char (point-max))
      (transflow-mode 1)) buffer))
(ert-deftest transflow-native-independent-completion-and-diagnostics ()
  (let* ((transflow-executable (getenv "TRANSFLOW_CLI"))
         (transflow-python (getenv "TRANSFLOW_PYTHON"))
         (root-a (getenv "TRANSFLOW_EDITOR_A"))
         (root-b (getenv "TRANSFLOW_EDITOR_B"))
         (a (transflow-test--buffer root-a "from transflow.catalog import C\nC.raw."))
         (b (transflow-test--buffer root-b "from transflow.catalog import C\nC.raw.")))
    (unwind-protect
        (progn
          (with-current-buffer a
            (should (member #'python-completion-at-point completion-at-point-functions))
            (should (equal (nth 2 (transflow-completion-at-point)) '("orders"))))
          (with-current-buffer b
            (should (equal (nth 2 (transflow-completion-at-point)) '("invoices"))))
          (with-current-buffer a
            (insert "invoices")
            (let ((report (transflow--request 'textDocument/diagnostic)))
              (should (cl-find "unknown-dataset" (append (plist-get report :items) nil)
                               :key (lambda (d) (plist-get d :code)) :test #'equal)))
            (let* ((path (expand-file-name ".transflow/catalog.toml" root-a))
                   (text (with-temp-buffer (insert-file-contents path) (buffer-string))))
              (with-temp-file path (insert (replace-regexp-in-string "raw/orders" "raw/shipments" text)))
              (delete-region (line-beginning-position) (point)) (insert "C.raw.")
              (should (equal (nth 2 (transflow-completion-at-point)) '("shipments")))))
          (with-current-buffer b
            (should (equal (nth 2 (transflow-completion-at-point)) '("invoices")))))
      (transflow-stop)
      (dolist (buffer (list a b)) (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))))
(ert-deftest transflow-native-utf16-and-uri ()
  (with-temp-buffer
    (insert "é😀ab")
    (should (equal (transflow--position) '(:line 0 :character 5)))
    (should (= (transflow--point '(:line 0 :character 3)) 3)))
  (should (string-match-p "é\\|%C3%A9" (transflow--uri "/tmp/é space.py")))
  (should (string-match-p "%20" (transflow--uri "/tmp/é space.py"))))
(ert-deftest transflow-native-producer-navigation ()
  (let* ((transflow-executable (getenv "TRANSFLOW_CLI"))
         (transflow-python (getenv "TRANSFLOW_PYTHON"))
         (root (getenv "TRANSFLOW_EDITOR_PRODUCER"))
         (draft (transflow-test--buffer root "from transflow.catalog import C\nC.raw.orders"))
         producer)
    (unwind-protect
        (with-current-buffer draft
          (let ((hover (transflow--request 'textDocument/hover)))
            (should (string-match-p "Descriptor source snapshot:" (plist-get (plist-get hover :contents) :value))))
          (transflow-open-producer)
          (setq producer (current-buffer))
          (should (equal (file-truename buffer-file-name)
                         (file-truename (expand-file-name "src/orders.py" root))))
          (should (= (line-number-at-pos) 2)))
      (transflow-stop)
      (dolist (buffer (delq nil (list draft producer)))
        (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))))
(ert-deftest transflow-native-installed-sdk-completion-coexists ()
  (let* ((transflow-executable (getenv "TRANSFLOW_CLI"))
         (transflow-python (getenv "TRANSFLOW_PYTHON"))
         (root (getenv "TRANSFLOW_EDITOR_PRODUCER"))
         (buffer (transflow-test--buffer root "import transflow\ntransflow.In"))
         (python-shell-completion-native-enable nil)
         process)
    (unwind-protect
        (with-current-buffer buffer
          (setq process (run-python
                         (combine-and-quote-strings
                         (list (getenv "TRANSFLOW_INSTALLED_PYTHON") "-I" "-i" "-q"))
                         'buffer nil))
          (let ((deadline (+ (float-time) 10)))
            (while (and (process-live-p process) (< (float-time) deadline)
                        (not (with-current-buffer (process-buffer process) comint-last-prompt)))
              (accept-process-output process 0.05))
            (should (with-current-buffer (process-buffer process) comint-last-prompt)))
          (should (string-match-p "3, 14" (python-shell-send-string-no-output
                                            "import sys; print(sys.version_info[:2])" process)))
          (python-shell-send-string-no-output "import transflow, transflow.expectations" process)
          (transflow-python-shell-compat process)
          (should (equal (python-shell-send-string-no-output "print('é😀')" process) "é😀"))
          (should (seq-some (lambda (candidate) (string-prefix-p "transflow.Input" candidate))
                            (python-shell-completion-get-completions process "transflow.In")))
          (should (seq-some (lambda (candidate) (string-prefix-p "transflow.expectations.col" candidate))
                            (python-shell-completion-get-completions process "transflow.expectations.co")))
          (should (python-completion-at-point))
          (should-not (transflow-completion-at-point)))
      (when process (delete-process process) (kill-buffer (process-buffer process)))
      (transflow-stop)
      (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))))
